{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Site Downloader",
  "version": "0.1.0",
  "identifier": "dev.sitedownloader.app",
  "build": {
    "beforeDevCommand": "npm run build:worker && npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build:worker && npm run generate",
    "frontendDist": "../dist",
    "additionalWatchFolders": ["../worker"]
  },
  "app": {
    "windows": [
      {
        "title": "Site Downloader",
        "width": 940,
        "height": 720,
        "minWidth": 515,
        "minHeight": 550
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": {
      "../dist-worker/capture.cjs": "capture.cjs",
      "../node_modules/playwright-core/": "node_modules/playwright-core/"
    }
  }
}
